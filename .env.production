# Public build-time settings for the Book a Demo page. Never put secrets in this file.
VITE_BOOKING_API_BASE=https://func-qvm-bookdemo-prod-aue.azurewebsites.net
# Cloudflare Turnstile site key (public). While empty, the page keeps showing
# "Online scheduling is temporarily unavailable" and never calls the booking API.
VITE_TURNSTILE_SITE_KEY=
