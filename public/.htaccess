Options -MultiViews
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# Pages must be revalidated on every visit so returning visitors receive each release.
# Hashed /assets files keep the host's long-lived caching.
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, max-age=0, must-revalidate"
</FilesMatch>

# Serve real files and directories as-is. React Router handles SPA routes.
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
